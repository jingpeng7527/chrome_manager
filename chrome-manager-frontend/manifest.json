{
  "manifest_version": 3,
  "name": "Chrome Manager Agent",
  "version": "0.1.0",
  "description": "Manage Chrome tabs with natural language.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Chrome Agent"
  },
  "side_panel": {
    "default_path": "pop_up.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "omnibox": {
    "keyword": "tab"
  }
}
